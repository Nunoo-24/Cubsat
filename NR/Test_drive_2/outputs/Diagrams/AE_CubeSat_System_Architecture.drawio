<mxfile host="app.diagrams.net" modified="2026-10-17T12:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="ae-architecture" name="System Architecture"><mxGraphModel dx="3400" dy="1760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="1760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="env" value="ENVIRONMENT / TEST PLANT" style="swimlane;html=1;startSize=52;rounded=1;horizontal=1;fillColor=#F0F7FF;swimlaneFillColor=#F0F7FF;strokeColor=#5B8DB8;strokeWidth=3;fontSize=25;fontStyle=1;align=left;spacingLeft=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="115" width="620" height="1520" as="geometry" /></mxCell><mxCell id="sat" value="CUBESAT — ONBOARD DOMAIN" style="swimlane;html=1;startSize=52;rounded=1;horizontal=1;fillColor=#EFFAF4;swimlaneFillColor=#EFFAF4;strokeColor=#4A9B73;strokeWidth=3;fontSize=25;fontStyle=1;align=left;spacingLeft=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="115" width="1840" height="1520" as="geometry" /></mxCell><mxCell id="gs" value="GROUND STATION — LOCAL PC" style="swimlane;html=1;startSize=52;rounded=1;horizontal=1;fillColor=#FFF8EC;swimlaneFillColor=#FFF8EC;strokeColor=#C58B36;strokeWidth=3;fontSize=25;fontStyle=1;align=left;spacingLeft=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2560" y="115" width="820" height="1520" as="geometry" /></mxCell><mxCell id="e1" value="scene state / target XYZ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#477A9D;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scene" target="plant"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="attitude + target visibility" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#477A9D;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="plant" target="render"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="synthetic image + XYZ sensor samples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#477A9D;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="render" target="simbridge"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="sim frame + sequence (RLE1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2F8C61;fontSize=17;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="simbridge" target="camera"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1150" /><mxPoint x="665" y="1150" /><mxPoint x="665" y="370" /></Array></mxGeometry></mxCell><mxCell id="e5" value="physical scene → optical image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2F8C61;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scene" target="camera"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="270" /><mxPoint x="665" y="270" /><mxPoint x="665" y="300" /></Array></mxGeometry></mxCell><mxCell id="e6" value="synthetic gyro / accel / mag XYZ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2F8C61;fontSize=17;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="render" target="sensors"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="845" /><mxPoint x="665" y="580" /><mxPoint x="1570" y="580" /><mxPoint x="1570" y="500" /></Array></mxGeometry></mxCell><mxCell id="e7" value="centroid → image X/Y bearing error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2F8C61;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="camera" target="controller"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="fresh XYZ rates / gravity / field" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#2F8C61;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sensors" target="controller"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="bounded yaw torque / speed command" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#BD8130;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="controller" target="actuator"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="sensor, target, state, fault + actuator telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#477A9D;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="controller" target="telem"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="reaction torque / body motion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#BD8130;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actuator" target="plant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1320" /><mxPoint x="660" y="1320" /><mxPoint x="660" y="535" /></Array></mxGeometry></mxCell><mxCell id="e12" value="virtual X/Y/Z commands, simulator source only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#25815A;fontSize=17;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="controller" target="simonly"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="simulated pitch/roll torque" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#25815A;fontSize=17;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="simonly" target="plant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="1450" /><mxPoint x="655" y="1450" /><mxPoint x="655" y="600" /></Array></mxGeometry></mxCell><mxCell id="e14" value="Wi-Fi telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#AD7528;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="telem" target="wifi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2490" y="1210" /><mxPoint x="2550" y="1210" /><mxPoint x="2550" y="305" /></Array></mxGeometry></mxCell><mxCell id="e15" value="TM/TC packets (physical framing TBD)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#AD7528;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wifi" target="decode"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="decoded observations / paired preview" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#AD7528;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decode" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="operator view + test selection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#AD7528;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ui" target="logcmd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="bounded command / acknowledgement path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#A24C8D;fontSize=17;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="logcmd" target="wifi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3370" y="1280" /><mxPoint x="3380" y="1280" /><mxPoint x="3380" y="300" /></Array></mxGeometry></mxCell><mxCell id="e19" value="supervisory command → XIAO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#A24C8D;fontSize=17;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="wifi" target="controller"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2570" y="305" /><mxPoint x="2545" y="305" /><mxPoint x="2545" y="800" /><mxPoint x="2490" y="800" /></Array></mxGeometry></mxCell><mxCell id="scene" value="&lt;b&gt;Scene / physical target&lt;/b&gt;&lt;br&gt;&lt;br&gt;Black point on poster; target pose and scale&lt;br&gt;Physical rig: gimbal motion, lighting, occlusion&lt;br&gt;Simulation UI: target XYZ/size, torque pulses, cover camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="45" y="180" width="570" height="195" as="geometry" /></mxCell><mxCell id="plant" value="&lt;b&gt;Environment dynamics&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim_Environment Python plant: yaw wheel +&lt;br&gt;simplified pendular pitch/roll; synthetic body state&lt;br&gt;Disturbance torque XYZ × duration; reaction torque&lt;br&gt;updates attitude and camera/sensor viewpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="45" y="410" width="570" height="250" as="geometry" /></mxCell><mxCell id="render" value="&lt;b&gt;Synthetic observation generation&lt;/b&gt;&lt;br&gt;&lt;br&gt;QVGA grayscale camera render (320×240)&lt;br&gt;Synthetic gyro XYZ, accelerometer XYZ, fixed-field&lt;br&gt;magnetometer; freshness, target visibility and&lt;br&gt;camera occlusion modeled&lt;br&gt;All values/calibration are provisional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="45" y="700" width="570" height="270" as="geometry" /></mxCell><mxCell id="simbridge" value="&lt;b&gt;Simulator bridge / test interface&lt;/b&gt;&lt;br&gt;&lt;br&gt;Versioned local HTTP/JSON endpoints&lt;br&gt;Camera frame paired by sequence; bounded lossless&lt;br&gt;RLE1 transport to host SIL / Wokwi profile&lt;br&gt;Ground Station may control the simulated scene&lt;br&gt;This is not the selected physical radio protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FC;strokeColor=#5B8DB8;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="45" y="1010" width="570" height="285" as="geometry" /></mxCell><mxCell id="simonly" value="&lt;b&gt;Simulation-only control path&lt;/b&gt;&lt;br&gt;&lt;br&gt;Host SIL closes the loop against the plant&lt;br&gt;Virtual pitch/roll torques are accepted only from&lt;br&gt;simulated observations; they are not physical&lt;br&gt;actuators. Keep this path visually distinct." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FC;strokeColor=#5B8DB8;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="45" y="1330" width="570" height="255" as="geometry" /></mxCell><mxCell id="camera" value="&lt;b&gt;CAMERA SYSTEM — XIAO ESP32-S3 SENSE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hardware: OV5640 camera (confirm kit revision; some board&lt;br&gt;variants may differ); autofocus path; QVGA grayscale frame&lt;br&gt;Process: threshold dark pixels → binary mask → 8-neighbour&lt;br&gt;coherence filter → centroid → offset from optical centre&lt;br&gt;Output: image X/Y error for pointing; preview + error for GS&lt;br&gt;Optional asymmetric marker estimates roll; point target alone&lt;br&gt;has no camera roll cue. Pixel-to-angle needs calibration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9B73;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="715" y="180" width="840" height="390" as="geometry" /></mxCell><mxCell id="sensors" value="&lt;b&gt;SENSOR SYSTEM — SHARED I²C INPUTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;MPU-6050: 3-axis gyro + accelerometer; breakout voltage /&lt;br&gt;logic levels must be checked before wiring (&amp;quot;5.5 V&amp;quot; is not&lt;br&gt;a safe bare-chip rating). Startup bias, scaling, timestamps.&lt;br&gt;LIS3MDL: XYZ magnetic field; selectable ±4/8/12/16 G.&lt;br&gt;Firmware uses I²C; mounting/axis map and magnetic calibration&lt;br&gt;are open. Physical magnetic correction is disabled pending&lt;br&gt;calibration and motor-interference checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9B73;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1580" y="180" width="900" height="390" as="geometry" /></mxCell><mxCell id="controller" value="&lt;b&gt;ONBOARD PROCESSING — SEEED XIAO ESP32-S3 SENSE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Camera + sensor observations enter the onboard 50 Hz reference loop.&lt;br&gt;Estimate: yaw-only gyro integration; SIL can use a known synthetic magnetic reference;&lt;br&gt;physical firmware is relative gyro yaw until mounting and magnetic calibration are known.&lt;br&gt;Visual pointing uses target image error + body-Y gyro rate; target loss falls back to rate damping.&lt;br&gt;Bounded control orders, age/validity checks, operating modes and watchdog protections.&lt;br&gt;Simulation source adds virtual pitch (image Y) / roll (optional marker) torques; physical&lt;br&gt;motor path is yaw-only. Controller gains, limits and plant constants remain uncalibrated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9B73;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="715" y="625" width="1765" height="405" as="geometry" /></mxCell><mxCell id="actuator" value="&lt;b&gt;ACTUATION SYSTEM — PHYSICAL PATH&lt;/b&gt;&lt;br&gt;&lt;br&gt;Seeed XIAO → bounded motor command → moteus r4.11&lt;br&gt;motor controller → 5208 Kv330 BLDC + reaction wheel&lt;br&gt;Wheel momentum change gives opposite body torque.&lt;br&gt;Interface candidate: TTL UART on moteus AUX2; ESP32-S3&lt;br&gt;TWAI is Classical CAN and cannot directly send CAN-FD.&lt;br&gt;UART wiring, drive config, motor power, watchdog and&lt;br&gt;safe stop are not built / hardware-verified.&lt;br&gt;Only yaw is physically actuated in current scope." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#C58B36;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="715" y="1085" width="850" height="445" as="geometry" /></mxCell><mxCell id="telem" value="&lt;b&gt;TELEMETRY / TELECOMMAND — ONBOARD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Telemetry inputs: camera error + preview metadata, gyro /&lt;br&gt;accel / mag XYZ, yaw estimate, mode/fault, controller and&lt;br&gt;actuator housekeeping, timestamps and freshness.&lt;br&gt;XIAO Wi-Fi packet/link layer → Ground Station.&lt;br&gt;Simulation: local HTTP/JSON + sequence-paired RLE1 frame.&lt;br&gt;Physical Wi-Fi/radio protocol, packet framing, security and&lt;br&gt;replay rules are not selected.&lt;br&gt;Ground commands are supervisory only, not the control loop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9B73;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1590" y="1085" width="890" height="445" as="geometry" /></mxCell><mxCell id="wifi" value="&lt;b&gt;WI-FI / DATA LINK BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Current simulator: local HTTP/JSON bridge&lt;br&gt;Physical link and TM/TC protocol: TBD&lt;br&gt;Telemetry flows to PC; bounded commands return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C58B36;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2590" y="180" width="760" height="245" as="geometry" /></mxCell><mxCell id="decode" value="&lt;b&gt;GROUND-STATION RECEIVE / DECODE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate and decode telemetry; pair frame metadata&lt;br&gt;with the matching preview; display sample age / link state&lt;br&gt;Keep invalid or stale samples out of trend lines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C58B36;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2590" y="465" width="760" height="250" as="geometry" /></mxCell><mxCell id="ui" value="&lt;b&gt;OPERATOR UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Time history: target direction / pointing error&lt;br&gt;Camera image with target centroid and error overlay&lt;br&gt;Housekeeping, mode, yaw estimate, sensor freshness,&lt;br&gt;actuator status and faults&lt;br&gt;Display simulator truth separately from CubeSat telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C58B36;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2590" y="755" width="760" height="325" as="geometry" /></mxCell><mxCell id="logcmd" value="&lt;b&gt;LOGGING + SUPERVISORY COMMANDS&lt;/b&gt;&lt;br&gt;&lt;br&gt;CSV telemetry logging on local PC&lt;br&gt;Bounded commands: PING, enumerated modes, relative&lt;br&gt;yaw step, timed wheel-speed commissioning&lt;br&gt;Acknowledgement/status returned in telemetry&lt;br&gt;No PC-side target error computation closes the loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C58B36;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2590" y="1120" width="760" height="350" as="geometry" /></mxCell><mxCell id="limits" value="&lt;b&gt;EVIDENCE / LIMITS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Host SIL verified; firmware, Wokwi, live network and hardware remain open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#C58B36;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2590" y="1510" width="760" height="90" as="geometry" /></mxCell><mxCell id="title" value="&lt;b&gt;AE CUBESAT ATTITUDE-CONTROL SYSTEM — 2D FUNCTIONAL / HARDWARE ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Data flow and domain boundaries; current implementation status is encoded in line styles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#263746;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="3000" height="65" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;Green solid = sensor/visual data path  •  Amber solid = physical actuator candidate  •  Green dashed = simulation-only virtual axes  •  Purple dashed = supervisory commands  •  Amber dashed box = hardware/interface decision or verification pending" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#263746;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="1650" width="2650" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>